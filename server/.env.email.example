# Локальная разработка: код выводится в консоль сервера
EMAIL_PROVIDER=console

# Продакшен через Resend
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAIL_FROM="Zugzwang.ai <noreply@your-domain.com>"

EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5

# Лучше задать отдельный секрет для hash email-кодов.
# Если не задан, используется JWT_SECRET.
# EMAIL_CODE_SECRET=change_me_to_long_random_secret

# Password reset.
# Если не указать эти переменные, будут использованы EMAIL_CODE_* настройки.
PASSWORD_RESET_CODE_TTL_MINUTES=10
PASSWORD_RESET_CODE_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_CODE_MAX_ATTEMPTS=5
PASSWORD_RESET_CODE_SECRET="change-this-password-reset-secret"
